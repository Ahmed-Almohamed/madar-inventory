{
  "name": "madar-inventory", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "check": "node --check src/worker.js && node --check public/app.js && node --test tests/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
